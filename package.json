{
  "name": "@guoyunhe/create",
  "version": "0.3.2",
  "description": "Initialize Node.js projects with Guo Yunhe's dev tools configuration",
  "keywords": [
    "cli",
    "create",
    "editorconfig",
    "husky",
    "lint-staged",
    "oxfmt",
    "oxlint"
  ],
  "license": "GPL-3.0-only",
  "author": {
    "name": "Guo Yunhe",
    "email": "i@guoyunhe.me",
    "url": "https://guoyunhe.me/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guoyunhe/create.git"
  },
  "funding": "https://ko-fi.com/guoyunhe",
  "bin": "dist/cli.mjs",
  "files": [
    "dist",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "dev": "tsx src/cli.ts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint",
    "prepare": "husky",
    "prepublishOnly": "pnpm build",
    "test": "node --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@guoyunhe/editorconfig": "^0.3.0",
    "commander": "^15.0.0",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@guoyunhe/oxfmt-config": "^1.1.0",
    "@types/node": "^26.6.5",
    "@types/semver": "^7.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-config-recommended": "^1.2.0",
    "tsdown": "^0.23.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,cts,jsx,tsx,vue}": [
      "oxfmt --write",
      "oxlint --fix"
    ],
    "*.{json,jsonc,css,scss,less,htm,html,md,mdx,yaml,yml}": "oxfmt --write",
    "*.css": "oxfmt --write",
    "*.{json,jsonc,scss,less,htm,html,md,mdx,yaml,yml}": "oxfmt --write"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=12.15.0",
      "onFail": "error"
    }
  },
  "engines": {
    "node": "^26.12.1 || ^24.22.1 || ^22.23.4"
  }
}
